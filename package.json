{
  "name": "spareshare-backend",
  "version": "2.0.0",
  "description": "SpareShare control plane: auth, devices, deployments, permanent URLs, monitoring, backup and failover for apps hosted on spare devices.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/run.js",
    "build:agent": "node ../agent/scripts/bundle.js",
    "dev:local": "node scripts/dev-local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14"
  }
}
